{
  "name": "knoellchen-pilot-video",
  "version": "0.1.0",
  "private": true,
  "description": "30s pitch video for Knöllchen-Pilot built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render Pitch out/pitch.mp4 --concurrency=4",
    "build:webm": "remotion render Pitch out/pitch.webm --codec=vp8",
    "build:still": "remotion still Pitch out/cover.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.300",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.300"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
