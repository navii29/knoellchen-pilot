# ============================================
# KNÖLLCHEN-PILOT — Environment Variables
# Kopiere diese Datei zu .env.local und trage echte Werte ein.
#
# Legende:
#   [PFLICHT]  — ohne diesen Wert funktioniert Signup/Portal in Production nicht
#   [OPTIONAL] — hat einen Default oder ist nur für einzelne Features nötig
# ============================================


# --------------------------------------------
# Supabase — Datenbank, Auth, Storage
# (Supabase Dashboard → Project Settings → API)
# --------------------------------------------
# [PFLICHT] Projekt-URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# [PFLICHT] Public Anon Key (Client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
# [PFLICHT] Service-Role-Key — NUR serverseitig, NIEMALS im Client/Repo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...


# --------------------------------------------
# Anthropic Claude — Strafzettel-OCR & Schadenerkennung (Vision)
# (console.anthropic.com → API Keys)
# --------------------------------------------
# [PFLICHT] Ohne Key schlagen Parse/Match/Foto-Vergleich fehl.
ANTHROPIC_API_KEY=sk-ant-api03-...


# --------------------------------------------
# App-URL — Basis für Magic-Links, Portal-Links, interne Calls
# --------------------------------------------
# [PFLICHT in Production] Lokal: http://localhost:3000
# In Production die ECHTE Domain (z.B. https://app.knoellchen-pilot.de),
# NICHT localhost und NICHT eine *.vercel.app-Preview — sonst sind
# Magic-Links / Portal-Links tot.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --------------------------------------------
# Kundenportal — JWT-Auth & Cookies
# --------------------------------------------
# [PFLICHT] Signiert die Portal-Session-JWTs. Mindestens 24 Zeichen.
# Erzeugen mit:  openssl rand -hex 32
# WARNUNG: Fehlt der Wert (oder ist er zu kurz), CRASHT das Kundenportal
# beim Login/Session-Check.
PORTAL_JWT_SECRET=
# [OPTIONAL] Cookie-Domain fürs Portal, z.B. .knoellchen-pilot.de
# (nötig wenn Portal auf einer Subdomain läuft). Leer = Host-only-Cookie.
PORTAL_COOKIE_DOMAIN=


# --------------------------------------------
# Postmark — E-Mail-Versand & Inbound
# (postmarkapp.com)
# --------------------------------------------
# [PFLICHT für Mailversand] Server-Token (Server Settings → API Tokens)
POSTMARK_SERVER_TOKEN=
# [OPTIONAL] Fallback-Absender, wenn Org keine eigene sender_email hat.
POSTMARK_DEFAULT_SENDER=noreply@knoellchen-pilot.de
# [OPTIONAL] Domain für Inbound-Mail (MX-Records in Postmark eingerichtet).
POSTMARK_INBOUND_DOMAIN=knoellchen-pilot.de
# [OPTIONAL] Beliebiger Secret-String — als ?token=... an die Postmark
# Inbound-Webhook-URL anhängen, um den Webhook abzusichern.
POSTMARK_WEBHOOK_SECRET=


# --------------------------------------------
# E-Mail-Test-Modus
# --------------------------------------------
# [OPTIONAL, nur Dev] Wenn gesetzt, gehen ALLE ausgehenden Mails an diese
# Adresse statt an Mieter/Behörde (Subject bekommt [TEST]-Prefix,
# Original-Empfänger bleibt im Ticket gespeichert).
# WARNUNG: MUSS in Production LEER sein — sonst gehen ALLE Mails an diese
# Adresse statt an Mieter/Behörden.
EMAIL_TEST_OVERRIDE=


# --------------------------------------------
# Cron / Health-Endpoint
# --------------------------------------------
# [OPTIONAL] Schützt /api/health (täglicher Vercel-Cron als Supabase-Keep-alive).
# Wenn gesetzt, muss der Aufruf "Authorization: Bearer <CRON_SECRET>" senden
# (Vercel-Cron sendet das automatisch). Leer = Endpoint öffentlich.
CRON_SECRET=


# --------------------------------------------
# Interne API-Calls (Server → Server)
# --------------------------------------------
# [OPTIONAL] Wird beim Checkout-Abschluss als x-internal-secret-Header an den
# Foto-Vergleich mitgeschickt (best-effort Triggerung). Reserviert für die
# Absicherung interner Trigger-Calls. Leer = Header wird nicht gesetzt.
INTERNAL_API_SECRET=


# --------------------------------------------
# Buchungslink (Landingpage-CTA)
# --------------------------------------------
# [OPTIONAL] Überschreibt den "Termin buchen"-Link.
# Default: Calendly-30-Min-Termin mit dem Gründer.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/f-edlmair-cooodex/30min


# --------------------------------------------
# Echoes.solutions — GPS-Telematik (aktuell STUB / Dummy-Daten)
# --------------------------------------------
# [OPTIONAL] Base-URL der Echoes-API. Default: https://api.echoes.solutions/v1
# Solange die echte API-Doku fehlt, liefert der Client Dummy-Daten.
ECHOES_BASE_URL=https://api.echoes.solutions/v1


# --------------------------------------------
# Vertrags-PDF-Rendering (Puppeteer/Chromium)
# --------------------------------------------
# [OPTIONAL, nur lokal] Pfad zu einer lokalen Chrome/Chromium-Binary für die
# PDF-Erzeugung. Default unter macOS wird automatisch versucht. In Production
# (Vercel/Lambda) wird automatisch chromium-min verwendet — hier nichts setzen.
# Beispiel macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=


# --------------------------------------------
# Automatisch gesetzt — NICHT manuell eintragen
# --------------------------------------------
# NODE_ENV            → von Next.js gesetzt (development/production)
# VERCEL, VERCEL_URL  → von Vercel automatisch gesetzt
# AWS_REGION,
# AWS_LAMBDA_FUNCTION_NAME → von der Vercel/Lambda-Runtime gesetzt
#   (signalisieren dem PDF-Renderer die serverlose Umgebung)
