# ============================================
# KNÖLLCHEN-PILOT — Environment Variables
# Kopiere diese Datei zu .env.local und trage echte Werte ein.
# ============================================

# White-Label-/Partner-Modus (z. B. das separate "eazy-car-crm"-Deployment).
# =1 → keine Landingpage, "/" leitet direkt auf /login. Leer/ungesetzt →
# normale Landingpage (Haupt-Deployment). Nur im Partner-Projekt auf 1 setzen.
NEXT_PUBLIC_PARTNER_MODE=

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
# Legacy JWT Secret (Settings → JWT Keys → "Legacy JWT secret" → Reveal).
# HS256 secret PostgREST still uses to verify JWTs — portal JWTs are signed
# with it so Postgres RLS can read their claims. NOT the new JWT Signing Keys.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# Schützt Cron-Endpunkte (Vercel sendet den Bearer-Header automatisch mit).
# Beliebiger Zufallsstring; ohne ihn sind die Cron-Routen offen erreichbar.
CRON_SECRET=change-me-to-a-random-string

# Anthropic Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Portal-Auth (Kundenportal) — JWT-Secret, min. 24 Zeichen. PFLICHT, sonst
# wirft /portal beim Start. Mit `openssl rand -base64 48` erzeugen.
PORTAL_JWT_SECRET=
# Optionale Cookie-Domain für das Portal-Cookie (z.B. .knoellchen-pilot.de).
# Leer lassen für localhost / Vercel-Preview.
PORTAL_COOKIE_DOMAIN=
# Secret für den /api/health Cron (Vercel Cron Authorization-Header).
CRON_SECRET=

# Sentry — Fehler-Monitoring (sentry.io). DSN aus Project Settings → Client Keys.
# EU-Region wählen (…ingest.de.sentry.io). Leer = ausgeschaltet (kein Versand).
NEXT_PUBLIC_SENTRY_DSN=

# ── Shopify-Anbindung (Bestellungen → Kunde + Vertrag) ──────────────
# Variante A (empfohlen, Webhook im Shopify-Admin angelegt): HMAC-Secret
SHOPIFY_WEBHOOK_SECRET=
# Variante B (Webhook per API angelegt): geheimer Token in der Callback-URL
SHOPIFY_WEBHOOK_TOKEN=
# Fallback-Organisation, falls ?org= nicht in der URL steht
SHOPIFY_DEFAULT_ORG_ID=
# Erst-Import bestehender Shops (Backfill): Custom-App im Shopify-Admin
# (Scopes read_products + read_orders), Token hier hinterlegen
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
